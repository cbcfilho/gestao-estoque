# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Os arquivos de logotipo VÃO para o repositório: a Vercel constrói a partir
# do GitHub, então sem eles a marca não apareceria em produção. Sendo a marca
# da própria empresa, não há problema — se um dia for material de terceiro
# (a franqueadora, por exemplo), descomente as linhas abaixo e sirva a imagem
# de outro lugar.
# public/logo.*
# public/logo-icone.*
